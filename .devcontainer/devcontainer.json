{
  // GitHub Codespaces (or any devcontainer host): Java 21 + Node.js 22, the pinned APK Web Lab runtime downloaded and the runner built at creation.
  // Then: bash .devcontainer/runner.sh  (starts the runner on port 8081)  and  bash .devcontainer/demo.sh app.apk  (session + screenshot).
  "name": "APK Lab Micronaut service",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // SSH server: gh codespace ssh / gh codespace cp from your terminal (copy an APK in, a screenshot out)
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  // one VM session uses a Worker heap of up to 3 GB plus the JVM: 4 cores / 16 GB is the comfortable size
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/welcome.sh",
  "forwardPorts": [8081, 8080],
  "portsAttributes": {
    "8081": { "label": "runner", "onAutoForward": "notify" },
    "8080": { "label": "queue", "onAutoForward": "silent" }
  },
  "secrets": {
    "RUNNER_TOKEN": { "description": "Optional: the runner's Bearer token. Without it, runner.sh creates one and keeps it in ~/.apk-lab-runner-token." }
  },
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack", "humao.rest-client"] },
    "codespaces": { "openFiles": ["README.md"] }
  }
}
