<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="dev.apklab" level="${APKLAB_LOG:-INFO}"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
